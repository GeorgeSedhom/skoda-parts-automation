{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": false
  },
  "include": ["tests/**/*.ts", "playwright.config.ts", "configs/**/*.ts"]
}
